# Example environment variables for Pharmacy Frontend
# Copy this file to `.env` and edit values as needed.

# ─── API URL ──────────────────────────────────────────────────────────────────
# Web (browser / Vite dev server)
VITE_APP_API_URL=http://localhost:8080/v1/api

# Android emulator: 10.0.2.2 maps to the host machine's localhost.
# For production (real device/server), set both to your public API domain:
#   VITE_APP_API_URL=https://api.myfarmacy.com/v1/api
#   VITE_APP_API_URL_ANDROID=https://api.myfarmacy.com/v1/api
VITE_APP_API_URL_ANDROID=http://10.0.2.2:8080/v1/api

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_TIMEZONE=America/Mexico_City
VITE_APP_ENV=development
VITE_APP_NAME=Pharmacy Santo Niño
VITE_APP_VERSION=0.0.1
