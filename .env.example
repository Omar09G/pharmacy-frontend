# Example environment variables for Pharmacy Frontend
# Copy this file to `.env` and edit values as needed.

# Base URL for backend API
VITE_API_BASE_URL=http://localhost:8080/v1/api

# Optional examples:
# VITE_ENABLE_MOCKS=false
# VITE_OTHER_FLAG=some_value

# IANA timezone for date/time display and conversions (default: America/Mexico_City)
VITE_APP_TIMEZONE=America/Mexico_City
