# ─── API URL ──────────────────────────────────────────────────────────────────
# Web (browser / Vite dev server)
VITE_APP_API_URL=http://localhost:32773/v1/api

# Android emulator: 10.0.2.2 maps to the host machine's localhost.
# Leave this set for local dev so both platforms work without manual changes.
VITE_APP_API_URL_ANDROID=http://10.0.2.2:32773/v1/api
VITE_APP_ENV=development
VITE_APP_NAME=Pharmacy Santo Niño
VITE_APP_VERSION=0.0.1